<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>Rebus.AwsSnsAndSqs</RootNamespace>
    <AssemblyName>Rebus.AwsSnsAndSqs</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <license>https://ghe.coxautoinc.com/CoxAuto/Rebus.AwsSnsAndSqs/blob/master/LICENSE.md</license>
    <PackageProjectUrl>https://github.com/P47Phoenix/Rebus.AwsSnsAndSqs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/P47Phoenix/Rebus.AwsSnsAndSqs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>    <PackageTags>Rebus sns sqs messaging pubsub innersource</PackageTags>
    <Description>AWS SNS and SQS transport for Rebus 7.x - Major version upgrade with enhanced performance, nullable reference types support, and improved AWS integration</Description>
    <PackageReleaseNotes>Version 7.0.0: Major upgrade to Rebus 7.x framework. BREAKING CHANGES: Requires Rebus 7.x, nullable reference types enabled. See CHANGELOG.md for migration guide.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Configurations>Debug;Release;RelaseBuildLoadTest</Configurations>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>    <Version>7.0.0.0</Version>
    <AssemblyVersion>7.0.*</AssemblyVersion>
    <Deterministic>False</Deterministic>    
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>    
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>    
    <TargetFramework>netstandard2.0</TargetFramework>    
    <LangVersion>default</LangVersion>    
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <DefineConstants>RELEASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='RelaseBuildLoadTest|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <DefineConstants>RELEASE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'net45' ">
    <DefineConstants>NET45</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard1.3' ">
    <DefineConstants>NETSTANDARD1_3</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
    <DefineConstants>NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="RebusAmazon\SNS\**" />
    <EmbeddedResource Remove="RebusAmazon\SNS\**" />
    <None Remove="RebusAmazon\SNS\**" />
    <None Include="..\LICENSE.md">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.Core" Version="3.7.402.79" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.400.173" />
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.173" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Rebus" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyInfoFiles Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
</Project>
